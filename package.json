{
  "name": "leancord",
  "private": true,
  "version": "0.1.0",
  "description": "Injector Discord ringan tanpa Vencord, dengan sistem Addons",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "inject": "node scripts/installer.mjs inject",
    "uninject": "node scripts/installer.mjs uninject",
    "status": "node scripts/installer.mjs status",
    "addon": "node scripts/addon.mjs",
    "typecheck": "tsc --noEmit",
    "installer:build": "node scripts/sea.mjs"
  },
  "devDependencies": {
    "@electron/asar": "^4.3.1",
    "@types/node": "^22.20.5",
    "electron": "^44.7.0",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^7.0.2"
  }
}
